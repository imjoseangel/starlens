# StarLens Configuration
# Copy to .env and customize as needed.
# All values below are defaults — only override what you need.

# ─── Ollama ─────────────────────────────────────────────────
# API key for cloud models (gemma4:31b-cloud). Get from Ollama.
OLLAMA_API_KEY=
STARLENS_OLLAMA_HOST=http://localhost:11434
STARLENS_OLLAMA_TIMEOUT=180
STARLENS_OLLAMA_MODEL_IDENTIFY=gemma4:e4b
STARLENS_OLLAMA_MODEL_REASON=gemma4:31b-cloud
# Comma-separated list of models for the UI dropdown
STARLENS_OLLAMA_AVAILABLE_MODELS=["gemma4:e2b","gemma4:e4b","gemma4:31b-cloud"]

# ─── Inference Options ──────────────────────────────────────
STARLENS_OPTS_TEMPERATURE_IDENTIFY=0.2
STARLENS_OPTS_TEMPERATURE_EXPLAIN=0.5
STARLENS_OPTS_TEMPERATURE_PLAN=0.4
STARLENS_OPTS_TEMPERATURE_NARRATE=0.7
STARLENS_OPTS_TEMPERATURE_TOUR=0.6
STARLENS_OPTS_TEMPERATURE_CHAT=0.5
STARLENS_OPTS_TEMPERATURE_CHART=0.3
STARLENS_OPTS_TEMPERATURE_WHY=0.4
STARLENS_OPTS_NUM_CTX_IDENTIFY=8192
STARLENS_OPTS_NUM_CTX_DEFAULT=32768
STARLENS_OPTS_NUM_CTX_CHAT=65536
STARLENS_OPTS_NUM_CTX_LARGE=131072

# ─── App / Gradio ──────────────────────────────────────────
STARLENS_APP_PORT=8000
STARLENS_APP_HOST=0.0.0.0
STARLENS_APP_SHARE=false
STARLENS_APP_LOG_LEVEL=INFO
STARLENS_APP_DEFAULT_CITY=Madrid, Spain
STARLENS_APP_FALLBACK_LAT=40.4168
STARLENS_APP_FALLBACK_LON=-3.7038

# ─── Redis Cache (optional — leave empty to disable) ───────
STARLENS_REDIS_URL=redis://localhost:6379/0
STARLENS_REDIS_TTL_SKY=300
STARLENS_REDIS_TTL_LLM=600
